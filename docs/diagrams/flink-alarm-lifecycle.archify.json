{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "N4-Monitor 告警生命周期状态机",
    "locale": "zh-CN",
    "output": "docs/diagrams/flink-alarm-lifecycle.html",
    "viewBox": [
      1080,
      720
    ],
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "主生命周期"
    },
    {
      "id": "pending",
      "label": "延迟确认"
    },
    {
      "id": "terminal",
      "label": "记录终态"
    }
  ],
  "states": [
    {
      "id": "normal",
      "type": "start",
      "label": "正常 / 无记录",
      "sublabel": "alarm:active 无告警",
      "lane": "main",
      "col": 0,
      "step": "00",
      "tag": "entry"
    },
    {
      "id": "start",
      "type": "active",
      "label": "start 告警开始",
      "sublabel": "Unack · duration 0",
      "lane": "main",
      "col": 2,
      "step": "01",
      "tag": "AlarmProcessFunction"
    },
    {
      "id": "continue",
      "type": "active",
      "label": "continue 持续",
      "sublabel": "保留 ack 状态与开始时间",
      "lane": "main",
      "col": 3,
      "step": "02",
      "tag": "同级别"
    },
    {
      "id": "frozen",
      "type": "neutral",
      "label": "end 冻结",
      "sublabel": "未确认恢复 仍展示",
      "lane": "main",
      "col": 4,
      "step": "03",
      "tag": "stage=end"
    },
    {
      "id": "pending",
      "type": "waiting",
      "label": "Pending 延迟确认",
      "sublabel": "timeDelay > 0",
      "lane": "main",
      "col": 1,
      "tag": "keyed state"
    },
    {
      "id": "removed",
      "type": "success",
      "label": "移除 + 清除信号",
      "sublabel": "已确认恢复",
      "lane": "terminal",
      "col": 2,
      "tag": "alarm:active 删除"
    }
  ],
  "transitions": [
    {
      "id": "delay-enter",
      "from": "normal",
      "to": "pending",
      "label": "超阈值 且 timeDelay > 0",
      "fromSide": "right",
      "toSide": "left",
      "labelAt": [
        171,
        215
      ]
    },
    {
      "id": "delay-cancel",
      "from": "pending",
      "to": "normal",
      "label": "恢复正常 取消定时器",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "bottom",
      "route": "bottom-channel",
      "channelY": 300
    },
    {
      "id": "delay-confirm",
      "from": "pending",
      "to": "start",
      "label": "onTimer 到时确认",
      "note": "5 次写入统一确认时刻",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left",
      "labelAt": [
        330,
        205
      ]
    },
    {
      "id": "fire-now",
      "from": "normal",
      "to": "start",
      "label": "无延迟 立即触发",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "bottom",
      "route": "bottom-channel",
      "channelY": 252,
      "labelAt": [
        171,
        232
      ]
    },
    {
      "id": "tick",
      "from": "start",
      "to": "continue",
      "label": "同级别持续",
      "note": "duration 累计",
      "fromSide": "right",
      "toSide": "left",
      "labelAt": [
        479,
        205
      ]
    },
    {
      "id": "escalate",
      "from": "continue",
      "to": "start",
      "label": "级别升级",
      "note": "关闭旧阶段 end + 新开 start",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "top",
      "route": "top-channel",
      "channelX": 570,
      "channelY": 92
    },
    {
      "id": "recover-unack",
      "from": "continue",
      "to": "frozen",
      "label": "恢复正常 未确认",
      "variant": "security",
      "fromSide": "right",
      "toSide": "left",
      "labelAt": [
        633,
        205
      ]
    },
    {
      "id": "recover-ack",
      "from": "continue",
      "to": "removed",
      "label": "恢复正常 已确认",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "re-alarm",
      "from": "frozen",
      "to": "start",
      "label": "再次报警 新一轮",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "top",
      "route": "top-channel",
      "channelX": 780,
      "channelY": 62
    },
    {
      "id": "ack-frozen",
      "from": "frozen",
      "to": "removed",
      "label": "用户确认 Ack",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "bottom-channel",
      "channelY": 385,
      "labelAt": [
        655,
        358
      ]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "主路径",
      "items": [
        "每次数据帧对照 alarm:active 历史记录演进",
        "start 写入 Unack 记录并广播通知与实时通道",
        "continue 沿用原始 alarmStartTime 并累计 duration"
      ]
    },
    {
      "dot": "amber",
      "title": "延迟确认",
      "items": [
        "pending 期间不写 active，latest 保持正常态",
        "定时器用处理时间：无新数据到点也确认",
        "期间恢复正常则取消定时器，报警不会产生"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复与确认",
      "items": [
        "未确认恢复冻结为 end 仍展示等待确认",
        "已确认恢复直接移除并广播清除信号",
        "级别升级按 关闭旧阶段 + 新开 start 处理"
      ]
    }
  ]
}