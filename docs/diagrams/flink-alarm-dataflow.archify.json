      "labelDy": -26
    },
    {
      "from": "redis",
      "to": "frontend",
      "label": "notifications → WS",
      "classification": "Spring 监听广播",
      "variant": "emphasis",
      "labelDy": -22
    },
    {
      "from": "redis",
      "to": "tdrt",
      "label": "realtime 即时写",
      "classification": "生命周期事件",
      "variant": "default",
      "labelDx": -78
    },
    {
      "from": "redis",
      "to": "tdev",
      "label": "persist 秒级批量",
      "classification": "全量明细",
      "variant": "default",
      "labelDy": 62
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "中间件职责边界",
      "items": [
        "EMQX 只做接入与桥接，不做规则评估",
        "Kafka 只做缓冲与解耦，Flink 与后端互不直连",
        "规则评估唯一发生在 Flink 作业内"
      ]
    },
    {
      "dot": "emerald",
      "title": "Redis 双重角色",
      "items": [
        "规则缓存：MySQL 同步而来，60s TTL 生效",
        "运行状态：latest 每帧覆盖、active 告警记录",
        "Pub/Sub 三通道把结果分发给后端消费者"
      ]
    },
    {
      "dot": "violet",
      "title": "TDengine 双表落盘",
      "items": [
        "alarm_realtime 只记告警生命周期事件（即时写）",
        "alarm_event 记录每帧全量明细（每秒批量）",
        "后端不消费 Kafka，只订阅 Redis 通道"
      ]
    }
  ]
}