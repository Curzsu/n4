        "已恢复记录确认后移除，进行中记录原地置 Ack",
        "确认结果再广播一次让前端即时刷新"
      ]
    },
    {
      "dot": "rose",
      "title": "可靠性",
      "items": [
        "每 60s 用 PUBSUB NUMSUB 检查订阅存活",
        "订阅静默丢失时自动重启监听容器",
        "无前端连接时广播跳过并告警日志"
      ]
    }
