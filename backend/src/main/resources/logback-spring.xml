<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Include Spring Boot defaults: registers %clr (color) and %wEx (exception)
         converters and provides CONSOLE_LOG_PATTERN / FILE_LOG_PATTERN. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Property placeholders: log directory and file name.
         The relative path "logs" resolves to the working directory:
           - Local dev: backend/logs/
           - Docker:    /app/logs/ (WORKDIR in Dockerfile) -->
    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_FILE" value="${LOG_DIR}/n4-monitor"/>

    <!-- Console appender: colored output via Spring Boot's CONSOLE_LOG_PATTERN -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File appender: rolling by day + size, compressed archives.
         Single file max 50MB, keep 30 archives, total cap 500MB. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Suppress noisy third-party framework logs (migrated from application.yaml) -->
    <logger name="org.apache.flink" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.apache.pekko" level="WARN"/>

    <!-- Root: INFO level, dual output to console + file -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
