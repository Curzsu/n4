<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.n4monitor.mapper.PointDeploymentMapper">

    <select id="findAllForRuleMap" resultType="com.n4monitor.entity.PointDeploymentEntity">
        SELECT point_deploy_id, n4_address, alarm_code, type
        FROM point_deployment
        WHERE is_deleted = 0
    </select>

</mapper>
