# N4 Monitor environment template.
# Copy to .env (repo root) and fill in real values.
# NOTE: .env is NOT tracked in git (see .gitignore - *.env is ignored, only
# .env.example is committed). Create your local .env from this template on each
# deployment machine; never commit real credentials.
#
# Consumers of this file:
# - Local dev: Spring Boot loads it via spring.config.import in
#   monitor-backend/src/main/resources/application.yaml.
# - Docker deploy: docker compose interpolates ${...} from the .env file that
#   sits next to docker-compose.yml (same repo root).

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/n4_monitor?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# TDengine (REST mode, port 6041)
TDENGINE_URL=jdbc:TAOS-RS://localhost:6041/n4
TDENGINE_USERNAME=root
TDENGINE_PASSWORD=change-me

# FUXA (template provisioning + frontend iframe base URL)
FUXA_BASE_URL=http://localhost:1881

# Backend HTTP port (single global switch, default 8088).
# Change this ONE value and every consumer follows:
# - compose backend port mapping & nginx upstream (docker-compose.yml)
# - nginx reverse proxy target (rendered from template via envsubst)
# - Spring Boot server.port default (application.yaml ${SERVER_PORT:8088})
# Local dev default is 8088 (vite proxy + start-n4-monitor.bat).
SERVER_PORT=8088
