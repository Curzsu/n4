# N4 Monitor environment template.
# Copy to .env (repo root) and fill in real values.
# NOTE: .env is currently tracked in this private self-hosted repo for deploy
# convenience. If the repo ever becomes public or is shared more widely,
# remove .env from tracking and rotate all credentials first.
#
# Consumers of this file:
# - Local dev: Spring Boot loads it via spring.config.import in
#   monitor-backend/src/main/resources/application.yaml.
# - Docker deploy: docker compose interpolates ${...} from the .env file that
#   sits next to docker-compose.yml (same repo root).

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/n4_monitor?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# TDengine (REST mode, port 6041)
TDENGINE_URL=jdbc:TAOS-RS://localhost:6041/n4
TDENGINE_USERNAME=root
TDENGINE_PASSWORD=change-me

# FUXA (template provisioning + frontend iframe base URL)
FUXA_BASE_URL=http://localhost:1881
